<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AppCfg.Migrate</RootNamespace>
    <AssemblyName>appcfg-migrate</AssemblyName>

    <!-- dotnet global tool: dotnet tool install -g AppCfg.Net.Migrate -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>appcfg-migrate</ToolCommandName>
    <PackageId>AppCfg.Net.Migrate</PackageId>
    <Version>1.0.0</Version>
    <Title>AppCfg.Net migration tool</Title>
    <Description>Command-line tool that migrates appSettings / connectionStrings from a .NET Framework App.config or Web.config into the user-secrets file (secrets.json) used by AppCfg.Net and the .NET Secret Manager.</Description>
    <Authors>Hung Vo</Authors>
    <PackageProjectUrl>https://github.com/minhhungit/AppCfg/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/minhhungit/AppCfg/</RepositoryUrl>
    <PackageTags>configuration appsettings user-secrets migration dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppCfg\AppCfg.csproj" />
  </ItemGroup>

</Project>
