<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>

  <appSettings>
    <!-- Feature Toggles -->
    <add key="Demo:EnableDatabase" value="false" />
    <add key="Demo:EnableRedis" value="false" />

    <!-- Basic Types Demo -->
    <add key="DemoBoolean" value="1" />
    <add key="DemoDateTime" value="11/29/2017 23:39:03" />
    <add key="DemoDateTimeWithFormat" value="24+09/2015" />
    <add key="DemoDecimal" value="-123,36.8999" />
    <add key="DemoDouble" value="1.7E+3" />
    <add key="DemoGuid" value="{8ff3a01d-1884-4ebd-b787-d5980aa94899}" />
    <add key="DemoInt" value="42" />
    <add key="long-key" value="9,223,372,036,854,775,807" />
    <add key="DemoString" value="hello, I'm a string from App.config" />
    <add key="DemoTimeSpanFirst" value="01:02:03" />
    <add key="DemoTimeSpanSecond" value="01:02:03:04" />

    <!-- List Collections -->
    <add key="Numbers" value="1^99^1,234,567,89" />
    <add key="StringList" value="apple;banana;cherry" />
    <add key="GuidList" value="{8ff3a01d-1884-4ebd-b787-d5980aa94899}|{9aa4b02e-2995-5fce-c898-e6091bb95900}" />
    <add key="BoolList" value="true,false,1,0" />
    <add key="DateTimeList" value="2020-01-01;2021-06-15;2022-12-31" />

    <!-- JSON Configuration -->
    <add key="cute_animal" value="{Name : 'Duck', legs : '2', SampleDay : '26+11+2018', CanSwim : true}" />
    <add key="test_setting_with_js_config" value="{DayWithNewFormat : '26|Dec+2019'}" />

    <!-- Enum Examples -->
    <add key="enum_by_int" value="1" />
    <add key="enum_by_string" value="ThirdValue" />
    <add key="hello_enum" value="World" />

    <!-- Custom Parser Examples -->
    <add key="test-json-file" value="JsonData/json-settings-test-json-file.json" />
    <add key="hello-world" value="JsonData/json-settings-hello-world.json" />

    <!-- ChainedStore Demo - These can be overridden by Environment Variables or User Secrets -->
    <add key="ChainedDemo:AppConfigValue" value="from-appconfig" />
    <add key="ChainedDemo:SecretValue" value="not-a-secret-in-appconfig" />
    <add key="ChainedDemo:EnvVarValue" value="not-from-env" />
    <add key="ChainedDemo:OverrideMe" value="appconfig-default" />

    <!-- Environment Variables Demo -->
    <add key="Env:SimpleString" value="from-appconfig-fallback" />
    <add key="Env:IntValue" value="100" />

    <!-- DefaultOption Demo -->
    <add key="DefaultDemo:Category" value="Technology" />
    <add key="DefaultDemo:Priority" value="High" />

    <!-- Multi-Tenancy Demo - Uses InMemoryTenantStore (see CustomStores/InMemoryTenantStore.cs) -->
    <!-- Multi-tenancy requires a custom store that handles tenant-specific values -->

    <!-- Advanced Features Demo -->
    <add key="Advanced:ReadOnlyInts" value="10;20;30;40;50" />
    <add key="Advanced:ReadOnlyStrings" value="alpha,beta,gamma" />
    <add key="Advanced:RegularString" value="  This string will be trimmed  " />
    <!-- Advanced:MissingValue is intentionally not in config to show RawValue inline default -->

    <!-- Error Handling Demo -->
    <add key="Error:ValidInt" value="123" />
    <add key="Error:InvalidInt" value="not-a-number" />
    <add key="Error:ValidGuid" value="{12345678-1234-1234-1234-123456789012}" />

    <!-- Computed Settings Demo -->
    <add key="Computed:Host" value="db.example.com" />
    <add key="Computed:Port" value="5432" />
    <add key="Computed:Database" value="production" />
    <add key="Computed:Username" value="app_user" />

    <!-- Nested Settings Demo -->
    <add key="Nested:DatabaseName" value="ProductionDB" />
    <add key="Nested:CacheTimeout" value="00:05:00" />

  </appSettings>

  <connectionStrings>
    <!-- Connection String Examples -->
    <add name="myConnFirst" connectionString="Data Source=(local); Initial Catalog=Microsoft;User ID=u4erN@me;Password=p@55w0rd" providerName="System.Data.SqlClient" />
    <add name="myConnSecond" connectionString="Data Source=JINPC\MSSQL2017;Initial Catalog=AppCfgDatabase;Integrated Security=True;Connection Timeout=180;" providerName="System.Data.SqlClient" />

    <!-- Database Store Demo Connection -->
    <add name="DemoDatabase" connectionString="Data Source=(local);Initial Catalog=AppCfgDatabase;Integrated Security=True;Connection Timeout=30;" providerName="System.Data.SqlClient" />

    <!-- Redis Store Demo Connection -->
    <add name="DemoRedis" connectionString="localhost:6379,defaultDatabase=0" providerName="Redis" />
  </connectionStrings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-11.0.0.0" newVersion="11.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
